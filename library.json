{
    "name": "CustomOTA",
    "version": "1.3.0",
    "description": "Real-time compatible ESP32 OTA library with automatic backup detection, boot partition validation, dual partition support, filesystem updates, heap monitoring, enhanced rollback validation, and configurable restart delays",
    "keywords": [
        "ota",
        "esp32",
        "update",
        "firmware",
        "filesystem",
        "spiffs",
        "web",
        "rollback",
        "backup",
        "partition",
        "real-time",
        "async",
        "auto-detection",
        "heap-monitoring",
        "security",
        "validation"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/boydsta/CustomOTA-ESP32.git"
    },
    "authors": [
        {
            "name": "Boyd Benton",
            "email": "31177555+boydsta@users.noreply.github.com",
            "url": "https://github.com/boydsta"
        }
    ],
    "license": "MIT",
    "homepage": "https://github.com/boydsta/CustomOTA-ESP32",
    "dependencies": [
        {
            "name": "AsyncTCP",
            "version": "^3.2.3",
            "authors": "Hristo Gochkov"
        },
        {
            "name": "ESPAsyncWebServer", 
            "version": "^3.1.1",
            "authors": "Hristo Gochkov"
        }
    ],
    "frameworks": ["arduino", "espidf"],
    "platforms": ["espressif32"],
    "build": {
        "includeDir": "src",
        "extraScript": "build_timestamp.py"
    },
    "export": {
        "include": [
            "src/*",
            "build_timestamp.py",
            "examples/*",
            "partitions/*",
            "*.md",
            "*.txt",
            "library.*",
            "LICENSE"
        ],
        "exclude": [
            "examples/*/.pio",
            "examples/*/.vscode", 
            "examples/*/build",
            "**/.git*"
        ]
    }
}
